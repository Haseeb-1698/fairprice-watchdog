# PostgreSQL Configuration (for Docker Compose)
POSTGRES_USER=fairprice
POSTGRES_PASSWORD=fairprice123
POSTGRES_DB=fairprice_watchdog

# Database Configuration
DATABASE_URL=postgresql+asyncpg://fairprice:fairprice123@localhost:5432/fairprice_watchdog

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# BrightData API Configuration
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fairprice-evidence

# Application Configuration
APP_NAME=FairPrice Watchdog
DEBUG=False