# ─────────────────────────────────────────────────────────────────────────────
# FairPrice Watchdog — environment
# Copy to .env and fill in. Everything except DATABASE_URL / REDIS_URL is
# optional: leave blank to run the agent pipeline in MOCK MODE (no credits used).
# NEVER commit a filled-in .env — it is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (for Docker Compose)
POSTGRES_USER=fairprice
POSTGRES_PASSWORD=fairprice123
POSTGRES_DB=fairprice_watchdog

# Core infra (required)
DATABASE_URL=postgresql+asyncpg://fairprice:fairprice123@localhost:5432/fairprice_watchdog
REDIS_URL=redis://localhost:6379/0

# ── Bright Data ──────────────────────────────────────────────────────────────
# Residential proxy zone (Crawler + Web Unlocker). State-level geo is set per
# request from the proxy username, e.g. ...-country-us-state-ca
BRIGHTDATA_API_KEY=
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
BRIGHTDATA_ZONE_PASSWORD=
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335
# Residential zone — supports state/city/ZIP geo targeting (the demo axis)
BRIGHTDATA_RESIDENTIAL_ZONE=
BRIGHTDATA_RESIDENTIAL_PASSWORD=
# Browser API (Scraping Browser) zone — drivable CDP endpoint for Journey Sim
BRIGHTDATA_BROWSER_ZONE=
BRIGHTDATA_BROWSER_PASSWORD=
BRIGHTDATA_BROWSER_HOST=brd.superproxy.io
BRIGHTDATA_BROWSER_PORT=9222
# SERP API zone (Discovery agent)
BRIGHTDATA_SERP_ZONE=

# ── LLM providers (fee classification / law mapping) ─────────────────────────
# LLM_PROVIDER: auto picks the first configured provider below. Or pin one:
# anthropic | azure_kimi | openai | mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
# Direct Kimi / Moonshot platform (https://platform.kimi.ai) — OpenAI-compatible
KIMI_API_KEY=
KIMI_ENDPOINT=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5
# Azure-hosted Kimi (alternative)
AZURE_KIMI_ENDPOINT=
AZURE_KIMI_KEY=
AZURE_KIMI_MODEL=Kimi-K2.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Evidence vault (S3-compatible) ───────────────────────────────────────────
# STORAGE_BACKEND=minio (local, default) or r2 (Cloudflare R2, cloud deploy).
STORAGE_BACKEND=minio
# MinIO (local docker)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fairprice-evidence
MINIO_SECURE=False
# Cloudflare R2 (set STORAGE_BACKEND=r2 to use)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fairprice-evidence
R2_PUBLIC_BASE_URL=

# ── Scan behaviour ───────────────────────────────────────────────────────────
DEFAULT_SCAN_STATES=CA,TX
SCAN_STOP_BEFORE_PAYMENT=True
BRIGHTDATA_CREDIT_CAP=500

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=FairPrice Watchdog
DEBUG=False
